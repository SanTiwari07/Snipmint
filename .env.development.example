# Local development settings. Copy to .env.development (git-ignored).
# Read automatically by `snipmint serve --dev` and by docker-compose.dev.yml; never by the
# production docker-compose.yml. Nothing has to be deployed: Google allows http://localhost callbacks.

# --- YouTube publishing with a DEVELOPMENT OAuth client ------------------------------------
# Create a separate "Web application" OAuth client for development in Google Cloud and add this
# Authorized redirect URI to it:
#   http://localhost:8000/api/youtube/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: in --dev mode an empty value means http://localhost:<SNIPMINT_PORT>/api/youtube/oauth/callback.
# Open Snipmint at http://localhost (not 127.0.0.1) so the sign-in cookie matches.
GOOGLE_REDIRECT_URI=
# The Vite dev server: where the browser lands after signing in (default in --dev mode).
SNIPMINT_UI_URL=http://localhost:5173
# A dev-only key, different from production.
SNIPMINT_SECRET_KEY=
# Keep development data apart from your real projects (optional).
# SNIPMINT_HOME=./data-dev
