# Copy this file to .env and fill in what you need. Everything is optional.
# After changing .env, restart Snipmint: docker compose up -d
# Lines starting with # are examples; remove the # to use them.

# --- Advanced AI (Gemini) -------------------------------------------------------------------
# Your key from https://aistudio.google.com/apikey . It stays on your computer: the web app
# never asks for it. Leave it empty to use the free analysis only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# Silent videos are watched by Gemini up to this length (minutes)
# GEMINI_VIDEO_MAX_MINUTES=45

# --- Local AI (any OpenAI-compatible server, e.g. Ollama) ----------------------------------
# With the ollama compose profile: LLM_BASE_URL=http://ollama:11434/v1
# LLM_BASE_URL=
# LLM_MODEL=qwen2.5:14b

# --- Transcription (faster-whisper) ---------------------------------------------------------
# The CPU image uses small/cpu/int8 and the GPU image large-v3-turbo/cuda/float16 by default.
# Only set these to override that (base is faster than small but less accurate).
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# --- Videos ---------------------------------------------------------------------------------
# YouTube cookies (Netscape format) for "sign in to confirm you're not a bot" errors:
# put the file in ./data and point to it as seen inside the container.
# YOUTUBE_COOKIES_FILE=/data/cookies.txt
# MAX_SOURCE_MINUTES=180
# Largest video file you can upload (MB)
# MAX_UPLOAD_MB=4096

# --- Server. --------------------------------------------------------------------------------
# Fixed access token (otherwise a random one is printed at start-up).
SNIPMINT_TOKEN=

# --- YouTube publishing (optional). Leave empty to turn it off. ------------------------------
# PRODUCTION / Docker settings. For local development use .env.development instead
# (copy .env.development.example) with its own OAuth client, so the two never mix.
# OAuth client of type "Web application" from Google Cloud (see README: "Publish to YouTube").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" of that client and the address people open
# Snipmint at. https:// on a public host, e.g. https://clips.example.com/api/youtube/oauth/callback;
# a Docker install used only on this computer can use http://localhost:8000/api/youtube/oauth/callback
GOOGLE_REDIRECT_URI=
# Encrypts the stored YouTube sign-in. Required in production: any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without it a key file is created in <data>/integrations/secret.key.
SNIPMINT_SECRET_KEY=
# Uploads running at the same time (1-4).
YOUTUBE_UPLOAD_CONCURRENCY=2
# Where the browser lands after Google's sign-in when the web app is served from another
# address than the API. Empty = same address as the API.
SNIPMINT_UI_URL=

# --- n8n workflow automation (optional). Leave SNIPMINT_N8N_WEBHOOK_SECRET empty to turn it off.
# Start n8n with: docker compose -f docker-compose.yml -f docker-compose.n8n.yml up -d
# See docs/n8n.md. n8n never gets Google credentials, YouTube tokens or SNIPMINT_TOKEN.
#
# Shared secret between Snipmint and n8n (at least 24 characters), e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the same value in the n8n credentials "Snipmint API" and "Snipmint webhook" (Header Auth,
# header name X-Snipmint-Secret).
SNIPMINT_N8N_WEBHOOK_SECRET=
# Where Snipmint sends its events: the base of n8n's production webhooks.
# docker-compose.n8n.yml sets this to http://n8n:5678/webhook for you.
# N8N_WEBHOOK_URL=http://localhost:5678/webhook
# How n8n reaches Snipmint (used in the workflow files; the default fits docker-compose.n8n.yml).
SNIPMINT_API_BASE_URL=http://snipmint:8000

# n8n itself (read by docker-compose.n8n.yml)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Public base URL n8n shows for its webhooks (n8n's WEBHOOK_URL); behind a proxy use https://
N8N_PUBLIC_URL=http://localhost:5678/
# Encrypts the credentials n8n stores. Generate once and keep it: losing it loses n8n credentials.
N8N_ENCRYPTION_KEY=
# Time zone for n8n's Schedule Trigger and its logs (scheduled clips themselves are stored in UTC).
N8N_TIMEZONE=UTC
# PostgreSQL that stores n8n's workflows and executions
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=
# n8n 1.0 and later ignore basic auth: the first visit creates the owner account (email +
# password) that protects the editor. Kept only for older setups.
# N8N_BASIC_AUTH_ACTIVE=false
# N8N_BASIC_AUTH_USER=
# N8N_BASIC_AUTH_PASSWORD=
