# Copy to .env and fill in what you need. Everything is optional.

# --- Advanced AI (Gemini). Leave empty for the free mode. ---------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Silent videos are watched by Gemini up to this length (minutes)
GEMINI_VIDEO_MAX_MINUTES=45

# --- Local AI (OpenAI-compatible server, e.g. Ollama). -------------------------------------
# With the ollama compose profile: http://ollama:11434/v1
LLM_BASE_URL=
LLM_MODEL=qwen2.5:14b

# --- Transcription (faster-whisper). --------------------------------------------------------
# small = good default on CPU; large-v3-turbo on a GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# --- YouTube downloads. ---------------------------------------------------------------------
# Netscape-format cookies file inside the container (put it in ./data and use /data/cookies.txt)
YOUTUBE_COOKIES_FILE=
MAX_SOURCE_MINUTES=180
# Largest video file you can upload (MB)
MAX_UPLOAD_MB=4096

# --- Server. --------------------------------------------------------------------------------
# Fixed access token (otherwise a random one is printed at start-up).
SNIPMINT_TOKEN=

# --- YouTube publishing (optional). Leave empty to turn it off. ------------------------------
# PRODUCTION / Docker settings. For local development use .env.development instead
# (copy .env.development.example) with its own OAuth client, so the two never mix.
# OAuth client of type "Web application" from Google Cloud (see README: "Publish to YouTube").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" of that client and the address people open
# Snipmint at. https:// on a public host, e.g. https://clips.example.com/api/youtube/oauth/callback;
# a Docker install used only on this computer can use http://localhost:8000/api/youtube/oauth/callback
GOOGLE_REDIRECT_URI=
# Encrypts the stored YouTube sign-in. Required in production: any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without it a key file is created in <data>/integrations/secret.key.
SNIPMINT_SECRET_KEY=
# Uploads running at the same time (1-4).
YOUTUBE_UPLOAD_CONCURRENCY=2
# Where the browser lands after Google's sign-in when the web app is served from another
# address than the API. Empty = same address as the API.
SNIPMINT_UI_URL=
