# Snipmint with NVIDIA GPU support (faster transcription).
#   docker compose --profile gpu up --build snipmint-gpu
# Needs an NVIDIA driver; on Windows, Docker Desktop with WSL2 GPU support.

FROM node:22-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04 AS app
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends software-properties-common \
 && add-apt-repository -y ppa:deadsnakes/ppa \
 && apt-get update \
 && apt-get install -y --no-install-recommends python3.12 python3.12-venv ffmpeg espeak-ng libsndfile1 libgl1 libglib2.0-0 curl \
 && rm -rf /var/lib/apt/lists/* \
 && python3.12 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

WORKDIR /app
COPY pyproject.toml README.md LICENSE NOTICE THIRD_PARTY_LICENSES.md ./
COPY snipmint ./snipmint
COPY --from=web /web/dist ./snipmint/server/static
RUN pip install --no-cache-dir ".[server,offline,transcribe,scenes,reframe,gemini]"

ENV SNIPMINT_HOME=/data \
    SNIPMINT_PORT=8000 \
    WHISPER_DEVICE=cuda \
    WHISPER_COMPUTE=float16 \
    WHISPER_MODEL=large-v3-turbo \
    HF_HOME=/models/huggingface \
    XDG_CACHE_HOME=/models/cache \
    PYTHONUNBUFFERED=1
VOLUME ["/data", "/models"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD curl -fs http://localhost:8000/api/health || exit 1
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN sed -i 's/\r$//' /app/entrypoint.sh
# Keeps one access token across restarts (see entrypoint.sh).
CMD ["sh", "/app/entrypoint.sh"]
